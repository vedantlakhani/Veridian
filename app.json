{
  "expo": {
    "name": "Veridian",
    "slug": "veridian",
    "scheme": "veridian",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vedantlakhani.veridian",
      "usesAppleSignIn": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Veridian uses your location to detect transport trips and estimate their carbon footprint.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Veridian detects your transport trips in the background so you never have to log a commute manually.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.vedantlakhani.veridian",
      "adaptiveIcon": {
        "backgroundColor": "#1B7A4A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Veridian detects your transport trips in the background so you never have to log a commute manually.",
          "locationWhenInUsePermission": "Veridian uses your location to detect transport trips and estimate their carbon footprint.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#191C1C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ce652d07-c05d-4df4-9e1c-d47797d472de"
      }
    }
  }
}
